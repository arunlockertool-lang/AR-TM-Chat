{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User profile with display name, handle, avatar, bio, and status",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 60, "minLength": 1 },
        "username": { "type": "string", "maxLength": 30, "minLength": 3, "pattern": "^[a-zA-Z0-9_]+$" },
        "email": { "type": "string", "format": "email", "maxLength": 120 },
        "avatarUrl": { "type": "string", "maxLength": 2048 },
        "bio": { "type": "string", "maxLength": 300 },
        "status": { "type": "string", "enum": ["online", "away", "busy", "offline"] },
        "lastSeen": { "type": "number" },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "name", "username", "status", "createdAt"]
    },
    "Chat": {
      "title": "Chat Channel",
      "description": "Direct message or group chat channel",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "type": { "type": "string", "enum": ["direct", "group"] },
        "name": { "type": "string", "maxLength": 100 },
        "avatarUrl": { "type": "string", "maxLength": 2048 },
        "description": { "type": "string", "maxLength": 500 },
        "participantIds": { "type": "array" },
        "adminIds": { "type": "array" },
        "pinnedMessageId": { "type": "string", "maxLength": 128 },
        "createdBy": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "type", "name", "participantIds", "createdAt"]
    },
    "Message": {
      "title": "Chat Message",
      "description": "Real-time chat message with text, media, or voice note",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "chatId": { "type": "string", "maxLength": 128 },
        "senderId": { "type": "string", "maxLength": 128 },
        "senderName": { "type": "string", "maxLength": 60 },
        "senderAvatar": { "type": "string", "maxLength": 2048 },
        "text": { "type": "string", "maxLength": 4000 },
        "timestamp": { "type": "number" },
        "status": { "type": "string", "enum": ["sending", "sent", "delivered", "read"] },
        "type": { "type": "string", "enum": ["text", "image", "voice", "file"] },
        "mediaUrl": { "type": "string", "maxLength": 2048 },
        "voiceDuration": { "type": "number" },
        "isEdited": { "type": "boolean" },
        "isPinned": { "type": "boolean" }
      },
      "required": ["id", "chatId", "senderId", "text", "timestamp", "type"]
    },
    "Story": {
      "title": "User Story",
      "description": "24-hour visual or text status story",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 60 },
        "userAvatar": { "type": "string", "maxLength": 2048 },
        "type": { "type": "string", "enum": ["image", "text"] },
        "content": { "type": "string", "maxLength": 2048 },
        "backgroundStyle": { "type": "string", "maxLength": 200 },
        "caption": { "type": "string", "maxLength": 200 },
        "createdAt": { "type": "number" },
        "expiresAt": { "type": "number" }
      },
      "required": ["id", "userId", "type", "content", "createdAt", "expiresAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Public user directory and profiles"
    },
    "/chats/{chatId}": {
      "schema": "Chat",
      "description": "Active group and direct conversations"
    },
    "/chats/{chatId}/messages/{messageId}": {
      "schema": "Message",
      "description": "Messages posted within an authorized conversation"
    },
    "/stories/{storyId}": {
      "schema": "Story",
      "description": "24-hour expiring visual and text status stories"
    }
  }
}
